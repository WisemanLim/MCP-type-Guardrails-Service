NODE_ENV=production
LOG_LEVEL=info

# Database backend: postgres (default, production) | sqlite (local, lightweight)
DB_DRIVER=postgres

POSTGRES_DB=guardrails
POSTGRES_USER=guardrails
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_EXPOSED_PORT=5432

REDIS_EXPOSED_PORT=6379

# Used only when DB_DRIVER=sqlite — per-service overridden inside containers.
SQLITE_PATH=./var/guardrails.db

DETECTION_EXPOSED_PORT=8081
POLICY_EXPOSED_PORT=8082
AUDIT_EXPOSED_PORT=8083
MCP_EXPOSED_PORT=8080
ADMIN_EXPOSED_PORT=8084

MCP_TRANSPORT=http
MCP_HTTP_AUTH=optional            # optional (no header) | required (x-api-key / Bearer)
GUARDRAILS_API_KEY=dev-key-please-change

# Phase activation. Overlays override these.
GUARDRAILS_ENABLED_DOMAINS=global
GUARDRAILS_LOCALES=ko-KR,en

# --- Admin Service (opt-in, docker-compose.admin.yml) ---
ADMIN_JWT_SECRET=change-me-in-prod
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_BCRYPT_ROUNDS=10
ADMIN_TOTP_ISSUER=Guardrails-Admin
# Optional bootstrap super_admin (created on first boot only if both set):
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SQLITE_PATH=/app/var/admin.db
